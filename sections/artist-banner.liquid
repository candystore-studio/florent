{% comment %}
  Artist hero. Solid-colour collection header matching the Florent collection redesign:
  breadcrumbs, collection title as the page h1, a "read the artist bio" anchor link with
  the works count beside it, and the collection description as an indexable intro
  paragraph in a second column on desktop.

  The description excerpt is plain text (strip_html + truncatewords); the full
  description renders in the bio section below the product grid, which the bio link
  anchors to. Every label and toggle is a section setting so it can be adjusted per
  template without code changes.
{% endcomment %}

{% liquid
  assign hero_collection = closest.collection | default: collection

  assign works_count = hero_collection.products_count
  assign count_label = section.settings.count_label_plural
  if works_count == 1
    assign count_label = section.settings.count_label_singular
  endif

  assign description_excerpt = ''
  if hero_collection.description != blank
    assign description_excerpt = hero_collection.description | strip_html | truncatewords: section.settings.description_word_limit
  endif
%}

{% render 'contrast-override',
  background_color: section.settings.background_color,
  section_id: section.id
%}

<div class="section-background color-custom-{{ section.id }}"></div>
<div
  class="section section--{{ section.settings.section_width }} color-custom-{{ section.id }}"
  data-testid="ui-test-section"
  {% if request.visual_preview_mode %}
    data-shopify-visual-preview
  {% endif %}
>
  <div
    class="artist-hero spacing-style"
    style="{% render 'spacing-style', settings: section.settings %}"
  >
    <div class="artist-hero__main">
      {% if section.settings.show_breadcrumbs %}
        <nav class="artist-hero__breadcrumbs" aria-label="Breadcrumbs">
          <a href="{{ routes.root_url }}">{{ section.settings.breadcrumb_home_label | escape }}</a>
          {% if section.settings.breadcrumb_parent_label != blank %}
            <span aria-hidden="true">/</span>
            {% if section.settings.breadcrumb_parent_link != blank %}
              <a href="{{ section.settings.breadcrumb_parent_link }}">
                {{- section.settings.breadcrumb_parent_label | escape -}}
              </a>
            {% else %}
              <span>{{ section.settings.breadcrumb_parent_label | escape }}</span>
            {% endif %}
          {% endif %}
          <span aria-hidden="true">/</span>
          <span class="artist-hero__breadcrumb-current" aria-current="page">{{ hero_collection.title | escape }}</span>
        </nav>
      {% endif %}

      <h1 class="artist-hero__title">{{ hero_collection.title | escape }}</h1>

      <div class="artist-hero__meta">
        {% if section.settings.show_bio_link and hero_collection.description != blank %}
          <a class="artist-hero__bio-link" href="#{{ section.settings.bio_anchor | escape }}">
            {{- section.settings.bio_link_label | escape -}}
          </a>
        {% endif %}
        {% if section.settings.show_count and works_count > 0 %}
          <span class="artist-hero__count">{{ works_count }} {{ count_label | escape }}</span>
        {% endif %}
      </div>
    </div>

    {% if section.settings.show_description and description_excerpt != blank %}
      <p class="artist-hero__description">{{ description_excerpt }}</p>
    {% endif %}
  </div>
</div>

{% stylesheet %}
  .artist-hero {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--gap-3xl, 4rem);
  }

  .artist-hero__main {
    display: flex;
    flex-direction: column;
    gap: 1.375rem;
    min-width: 0;
  }

  .artist-hero__breadcrumbs {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.5625rem;
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .artist-hero__breadcrumbs a,
  .artist-hero__breadcrumbs > span {
    color: currentcolor;
    opacity: 0.62;
    text-decoration: none;
  }

  .artist-hero__breadcrumbs a:hover,
  .artist-hero__breadcrumbs .artist-hero__breadcrumb-current {
    opacity: 1;
  }

  .artist-hero__title {
    margin: 0;
    text-wrap: balance;
  }

  /* Baseline alignment, not centre: the bio link carries a bottom border and its
     padding, so centring the boxes would lift its text above the count. */
  .artist-hero__meta {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    column-gap: 1.625rem;
    row-gap: 0.75rem;
    font-size: 0.75rem;
    letter-spacing: 0.1em;
    line-height: 1;
    text-transform: uppercase;
  }

  .artist-hero__bio-link {
    color: currentcolor;
    font-weight: 700;
    text-decoration: none;
    border-block-end: 2px solid currentcolor;
    padding-block-end: 5px;
  }

  .artist-hero__count {
    font-weight: 700;
    opacity: 0.6;
  }

  .artist-hero__description {
    margin: 0;
    inline-size: 340px;
    flex: none;
    font-size: 0.875rem;
    line-height: 1.62;
    text-wrap: pretty;
  }

  @media screen and (max-width: 749px) {
    .artist-hero {
      flex-direction: column;
      align-items: flex-start;
      gap: var(--gap-lg, 1.25rem);
    }

    .artist-hero__main {
      gap: 0.875rem;
    }

    .artist-hero__description {
      inline-size: 100%;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Artist hero",
  "class": "section-wrapper",
  "disabled_on": {
    "groups": ["header"]
  },
  "settings": [
    {
      "type": "header",
      "content": "Breadcrumbs"
    },
    {
      "type": "checkbox",
      "id": "show_breadcrumbs",
      "label": "Show breadcrumbs",
      "default": true
    },
    {
      "type": "text",
      "id": "breadcrumb_home_label",
      "label": "Home label",
      "default": "Home"
    },
    {
      "type": "text",
      "id": "breadcrumb_parent_label",
      "label": "Parent label",
      "info": "Leave blank to hide the middle crumb.",
      "default": "Artist"
    },
    {
      "type": "url",
      "id": "breadcrumb_parent_link",
      "label": "Parent link"
    },
    {
      "type": "header",
      "content": "Bio link and count"
    },
    {
      "type": "checkbox",
      "id": "show_bio_link",
      "label": "Show bio link",
      "info": "Hidden automatically when the collection has no description.",
      "default": true
    },
    {
      "type": "text",
      "id": "bio_link_label",
      "label": "Bio link label",
      "default": "Read the artist bio"
    },
    {
      "type": "text",
      "id": "bio_anchor",
      "label": "Bio anchor ID",
      "info": "Must match the anchor in the bio section below the grid.",
      "default": "artist-bio"
    },
    {
      "type": "checkbox",
      "id": "show_count",
      "label": "Show works count",
      "default": true
    },
    {
      "type": "text",
      "id": "count_label_singular",
      "label": "Count label (singular)",
      "default": "original work"
    },
    {
      "type": "text",
      "id": "count_label_plural",
      "label": "Count label (plural)",
      "default": "original works"
    },
    {
      "type": "header",
      "content": "Description"
    },
    {
      "type": "checkbox",
      "id": "show_description",
      "label": "Show description excerpt",
      "info": "A plain-text excerpt of the collection description. The full description renders in the bio section.",
      "default": true
    },
    {
      "type": "range",
      "id": "description_word_limit",
      "label": "Excerpt length",
      "min": 10,
      "max": 100,
      "step": 5,
      "unit": "wds",
      "default": 60
    },
    {
      "type": "header",
      "content": "t:content.appearance"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "t:settings.width",
      "options": [
        {
          "value": "page-width",
          "label": "t:options.page"
        },
        {
          "value": "full-width",
          "label": "t:options.full"
        }
      ],
      "default": "page-width"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:settings.background_color",
      "placeholder": "t:settings.default"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 44
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 46
    }
  ],
  "presets": [
    {
      "name": "Artist hero",
      "settings": {
        "show_breadcrumbs": true,
        "show_bio_link": true,
        "show_count": true,
        "show_description": true
      }
    }
  ]
}
{% endschema %}
