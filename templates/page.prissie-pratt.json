            "text_Dz9RWJ": {
              "type": "text",
              "name": "t:names.heading",
              "settings": {
                "text": "<p>Artist Bio</p>",
                "width": "100%",
                "max_width": "normal",
                "alignment": "center",
                "type_preset": "h4",
                "font": "var(--font-body--family)",
                "font_size": "1rem",
                "line_height": "normal",
                "letter_spacing": "normal",
                "case": "none",
                "wrap": "pretty",
                "background": false,
                "background_color": "#00000026",
                "corner_radius": 0,
